    "name": "mitei",
    "version": "1.0.0",
    "main": "src/index.ts",
    "author": "Bo Xu <xu.bo@sunoaki.net>",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "type": "module",
    "dependencies": {
        "@apollo/client": "^4.1.2",
        "@fastify/swagger": "^9.7.0",
        "@fastify/swagger-ui": "^5.2.5",
        "axios": "^1.13.6",
        "fast-xml-parser": "^5.4.2",
        "fastify": "^5.8.2",
        "graphql": "^16.12.0",
        "jose": "^6.1.0",
        "rxjs": "^7.8.2",
        "typebox": "^1.1.9",
        "typescript": "^5.9.3",
        "uuid": "^13.0.0",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.3.0",
        "babel-jest": "^30.3.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.1",
        "prettier": "^3.8.1",
        "ts-jest": "^29.4.4",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.56.1"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"**/*.{ts,json,md}\" ",
        "lint": "eslint \"src/**/*.ts\" --fix",
        "prepare": "husky",
        "precommit": "lint-staged && yarn run test:related",
        "test": "jest",
        "test:related": "node ./scripts/run-related-tests.mjs",
        "test:ci": "jest --runInBand --ci --coverage",
        "test:coverage": "jest --coverage",
        "test:watch": "jest --watch"
    },
    "lint-staged": {
        "*.{json,md}": "prettier --write",
        "src/**/*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
